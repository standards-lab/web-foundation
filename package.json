    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}